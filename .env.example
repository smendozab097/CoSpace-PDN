# Conexión a la base de datos PostgreSQL alojada en Supabase
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# Secretos JWT para autenticación
JWT_ACCESS_SECRET="tu_clave_secreta_para_access_tokens_muy_segura"
JWT_REFRESH_SECRET="tu_clave_secreta_para_refresh_tokens_muy_segura"

# Tiempos de expiración de los tokens
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# URL base de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
